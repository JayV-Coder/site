# O segredo que assina o cookie de sessão do NextAuth. Gere com:
#   npx auth secret   (ou: openssl rand -base64 33)
AUTH_SECRET=

# O endereço público do site, sem barra no fim (ex.: https://seu-dominio).
# Na Vercel o NextAuth descobre sozinho; fora dela, defina.
AUTH_URL=

# O mesmo projeto do Supabase do app. A chave publicável só identifica o
# projeto; sem estas variáveis o site usa as mesmas do app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# O provedor git das organizações (aba Repositórios): um app do site em cada
# provedor, com o retorno em
#   https://<domínio>/api/git/callback
# GitHub: só GitHub App (Settings › Developer settings › GitHub Apps); OAuth
# App não é mais aceito. As três variáveis são do GitHub App: Client ID,
# um client secret gerado nele e o slug (github.com/apps/<slug>). Sem o slug,
# o GitHub aparece indisponível. No app: Callback URL e Setup URL =
# https://<domínio>/api/git/callback, "Redirect on update" ligado, permissões
# de repositório Metadata e Contents: Read-only, "Any account" em onde pode
# ser instalado. Conectar o GitHub autoriza a pessoa e mostra no site as
# contas e organizações onde o app está instalado (sem nenhuma, a tela do
# GitHub de instalar).
GIT_GITHUB_CLIENT_ID=
GIT_GITHUB_CLIENT_SECRET=
GIT_GITHUB_APP_SLUG=
# GitLab › Preferences › Applications (confidencial, escopo read_api)
GIT_GITLAB_CLIENT_ID=
GIT_GITLAB_CLIENT_SECRET=
# Bitbucket › Workspace settings › OAuth consumers (Account: Read e
# Repositories: Read; o retorno acima como Callback URL)
GIT_BITBUCKET_CLIENT_ID=
GIT_BITBUCKET_CLIENT_SECRET=
