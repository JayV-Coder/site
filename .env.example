# O segredo que assina o cookie de sessão do NextAuth. Gere com:
#   npx auth secret   (ou: openssl rand -base64 33)
AUTH_SECRET=

# O endereço público do site, sem barra no fim (ex.: https://seu-dominio).
# Na Vercel o NextAuth descobre sozinho; fora dela, defina.
AUTH_URL=

# O mesmo projeto do Supabase do app. A chave publicável só identifica o
# projeto; sem estas variáveis o site usa as mesmas do app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# O provedor git das organizações (aba Repositórios): um app OAuth do site em
# cada provedor, separado do login do JayV, com o retorno em
#   https://<domínio>/api/git/callback
# GitHub › Settings › Developer settings › OAuth Apps
GIT_GITHUB_CLIENT_ID=
GIT_GITHUB_CLIENT_SECRET=
# GitLab › Preferences › Applications (confidencial, escopo read_api)
GIT_GITLAB_CLIENT_ID=
GIT_GITLAB_CLIENT_SECRET=
# Bitbucket › Workspace settings › OAuth consumers (Account: Read e
# Repositories: Read; o retorno acima como Callback URL)
GIT_BITBUCKET_CLIENT_ID=
GIT_BITBUCKET_CLIENT_SECRET=
